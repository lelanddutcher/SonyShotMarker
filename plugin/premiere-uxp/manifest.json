{
  "manifestVersion": 5,
  "id": "7e04f014",
  "name": "Sony Shot Marker",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "shotMarks",
      "label": {
        "default": "Sony Shot Marker"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 480
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 560
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light",
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
